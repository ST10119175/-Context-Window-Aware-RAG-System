# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# --- LLM Provider Configuration ---
# Choose your inference provider: "ollama", "vercel", or "mock"
PROVIDER=ollama

# Ollama Configuration (for local LLM inference)
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3

# Vercel API Configuration (for cloud-based inference)
VERCEL_CHAT_URL=https://llm-7q4e-projects.vercel.app/api/chat
VERCEL_API_KEY=your_vercel_api_key_here

# OpenAI Configuration (optional, for future integration)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4


